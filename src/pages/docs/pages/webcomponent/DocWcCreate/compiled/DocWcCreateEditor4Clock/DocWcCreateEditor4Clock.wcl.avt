import { Time } from "Aventus@Main:Aventus.package.avt";

export class DocWcCreateEditor4Clock extends Aventus.WebComponent implements Aventus.DefaultComponent {

	//#region static

    //#endregion


    //#region props
    @Property()
    public color: string = "red";
    @Watch()
    public timeTxt!: string;
    //#endregion


    //#region variables

    //#endregion


    //#region constructor

    //#endregion


    //#region methods
    private calcTime() {
        this.timeTxt = Time.now.toLocaleString();
    }
    protected override postCreation(): void {
        // When the component is rendered
        this.calcTime();
        setInterval(() => {
            this.calcTime();
        }, 1000);
    }
    //#endregion
	
}