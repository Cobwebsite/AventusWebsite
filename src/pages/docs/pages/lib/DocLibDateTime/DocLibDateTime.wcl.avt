import { DocGenericPage } from "../../DocGenericPage/DocGenericPage.wcl.avt";

export class DocLibDateTime extends DocGenericPage implements Aventus.DefaultComponent {
    protected override Title(): string { return "Date, DateTime and Time in Aventus"; }
