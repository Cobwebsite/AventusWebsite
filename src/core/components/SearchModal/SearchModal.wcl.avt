import { ModalElement } from "Aventus@UI:Aventus.Modal.package.avt";

export class SearchModal extends ModalElement<void> implements Aventus.DefaultComponent {

    //#region static

    //#endregion


    //#region props
    @Attribute()
    public is_focus!: boolean;
    //#endregion


    //#region variables
    @ViewElement()
    protected inputEl!: HTMLInputElement;

    private pagefind: any;
    private timeoutSearch?: number;
    //#endregion


    //#region constructor

    //#endregion


    //#region methods
    /**
     * @inheritdoc
     */
    public override configure(): Aventus.Modal.ModalOptions<void> {
        return {};
    }

    /**
     * 
     */
    protected onFocus() {
        this.is_focus = true;
    }
    /**
    * 
    */
    protected onBlur() {
        this.is_focus = false;
    }
    /**
    * 
    */
    protected async onInputChanged() {
        this.searchDelay();
    }

    protected searchDelay() {
        if(this.timeoutSearch != undefined) clearTimeout(this.timeoutSearch);

        this.timeoutSearch = setTimeout(() => {
            this.timeoutSearch = undefined;
            this.search();
        }, 300);
    }
    protected async search() {
        if(!this.pagefind) return;
        const search = this.inputEl.value;
        const results = await this.pagefind.search(search);
        const pages = await Promise.all(results.results.map((result: any) => result.data()));
        console.log(pages);
    }


    protected override postCreation(): void {
        super.postCreation();
        const uri = '/pagefind/pagefind.js';
        import(uri).then(async pagefind => {
            this.pagefind = pagefind;
        });
        this.inputEl.focus();
    }

    //#endregion

}