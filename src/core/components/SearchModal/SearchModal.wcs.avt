:host {
	align-items: flex-start;
	backdrop-filter: blur(4px);
	padding: 6rem 3rem;

	.modal {
		background-color: var(--primary-color);
		border: 1px solid color-mix(in oklab, black 5%, var(--primary-color));
		border-radius: 8px;
		box-shadow: var(--elevation-10);
		display: flex;
		flex-direction: column;
		max-height: min(85vh, 800px);
		max-width: 100%;
		padding: 16px 0;
		width: 800px;

		.header {
			flex-shrink: 0;
			padding: 0 16px;

			.input {
				align-items: center;
				background-color: var(--light-primary-color);
				border-radius: 8px;
				color: var(--aventus-font-color);
				display: flex;
				gap: 6px;
				padding: 4px 14px;
				position: relative;

				.border {
					border: 1px solid color-mix(in oklab, black 20%, var(--text-color));
					// border: 1px solid #323232;
					border-radius: 8px;
					inset: -1px;
					pointer-events: none;
					position: absolute;
					transition: border 0.1s linear;
				}

				mi-icon {
					font-size: 16px;
				}

				input {
					background-color: transparent;
					border: none !important;
					color: var(--aventus-font-color);
					flex: 1;
					height: 28px;
					min-width: 0;
					outline: none !important;
				}
			}

			.input:hover {
				.border {
					border: 2px solid #bdbdbd;
				}
			}
		}

		.body {
			flex-grow: 1;
			flex-shrink: 1;
			font-size: 16px;
			min-height: 0;
			padding: 16px 8px;

			.status {
				margin: 0;
				opacity: 0.7;
				padding: 0 24px;
			}

			.results {
				padding: 0 24px;

				.result {
					border-top: 1px solid color-mix(in oklab, var(--aventus-font-color) 15%, transparent);
					padding: 14px 0;

					av-link {
						color: var(--aventus-font-color);
						display: block;
						font-weight: 600;
					}

					av-link:hover {
						text-decoration: underline;
					}

					.excerpt {
						font-size: 0.8em;
						line-height: 1.4;
						margin: 6px 0 0;
						opacity: 0.75;
					}

					.sections {
						list-style: none;
						margin: 10px 0 0;
						padding: 0 0 0 16px;

						li {
							margin-top: 10px;
						}
					}
					.sections:not(:has(li)) {
						display: none;
					}
				}
			}
		}
	}
}

@media (max-width: 700px) {
	:host {
		padding: 2rem 1rem;

		.modal {
			padding: 1.5rem;
			width: 100%;
		}
	}
}

:host([is_focus]) {
	.modal {
		.header {
			.input {
				.border {
					border: 2px solid #bdbdbd;
				}
			}
		}
	}
}
