<div class="header">
    <div class="input">
        <div class="border"></div>
        <mi-icon icon="search"></mi-icon>
        <input type="text" placeholder="Search" @element="inputEl" @focus="onFocus" @blur="onBlur" @input="onInputChanged"/>
    </div>
</div>
<div class="body">
    <div class="result"></div>
</div>