import { ResultWithError, VoidWithError } from "Aventus@Main:Aventus.package.avt";
import { Todo } from "../data/Todo.data.avt";

export class TodoRAM extends Aventus.Ram<Todo> implements Aventus.IRam {


    private isLoaded: boolean = false;
    private static maxId: number = 0;

    /**
     * Create a singleton to store data
     */
    public static getInstance() {
        return Aventus.Instance.get(TodoRAM);
    }

    /**
     * @inheritdoc
     */
    public override defineIndexKey(): keyof Todo {
        return 'id';
    }
    /**
     * @inheritdoc
     */
    protected override getTypeForData(objJson: Aventus.KeysObject<Todo> | Todo): new () => Todo {
        return Todo;
    }


    /**
     * Save the content of the RAM inside local storage
     */
    protected saveToStorage() {
        let values = Array.from(this.records.values());
        localStorage.setItem("todos", JSON.stringify(values));
    }
    /**
     * Reload the content of the RAM from the local storage
     */
    protected async reloadFromStorage(): Promise<VoidWithError> {
        const result = new VoidWithError();
        let maxId = 0;
        let data = JSON.parse(localStorage.getItem("todos") ?? "[]");
        let values = Aventus.Converter.transform<Todo[]>(data);
        for(let value of values) {
            if(value.id > maxId) {
                maxId = value.id;
            }
            await result.runAsync(() => this.addOrUpdateData(value));
        }
        TodoRAM.maxId = maxId;
        return result;
    }

    protected override async beforeCreateItem(item: Todo, fromList: boolean): Promise<Aventus.VoidWithError> {
        const result = new VoidWithError();
        await result.runAsync(() => super.beforeCreateItem(item, fromList));
        TodoRAM.maxId++;
        item.id = TodoRAM.maxId;
        return result;
    }
    protected override async afterCreateItem(item: Aventus.RamItem<Todo, Todo>, fromList: boolean): Promise<Aventus.VoidWithError> {
        const result = new VoidWithError();
        await result.runAsync(() => super.afterCreateItem(item, fromList));
        this.saveToStorage();
        return result;
    }
    protected override async afterUpdateItem(item: Aventus.RamItem<Todo, Todo>, fromList: boolean): Promise<Aventus.VoidWithError> {
        const result = new VoidWithError();
        await result.runAsync(() => super.afterUpdateItem(item, fromList));
        this.saveToStorage();
        return result;
    }
    protected override async afterDeleteItem(item: Aventus.RamItem<Todo, Todo>, fromList: boolean): Promise<Aventus.VoidWithError> {
        const result = new VoidWithError();
        await result.runAsync(() => super.afterDeleteItem(item, fromList));
        this.saveToStorage();
        return result;
    }

    protected override async beforeGetAll(): Promise<Aventus.VoidWithError> {
        const result = new VoidWithError();
        await result.runAsync(() => super.beforeGetAll());
        if(!this.isLoaded) {
            await result.runAsync(() => this.reloadFromStorage());
            this.isLoaded = result.success;
        }
        return result;
    }

    /**
     * @inheritdoc
     */
    protected override async transformCreateRequestToItem(item: Todo): Promise<Aventus.ResultWithError<Todo>> {
        const result = new ResultWithError<Todo>();
        result.result = item;
        return result;
    }
    /**
     * @inheritdoc
     */
    protected override async transformCreateRequestListToItem(list: Todo[]): Promise<Aventus.ResultWithError<Todo[]>> {
        const result = new ResultWithError<Todo[]>();
        result.result = list;
        return result;
    }
    /**
     * @inheritdoc
     */
    protected override async transformUpdateRequestToItem(item: Todo): Promise<Aventus.ResultWithError<Todo>> {
        const result = new ResultWithError<Todo>();
        result.result = item;
        return result;
    }
    /**
     * @inheritdoc
     */
    protected override async transformUpdateRequestListToItem(list: Todo[]): Promise<Aventus.ResultWithError<Todo[]>> {
        const result = new ResultWithError<Todo[]>();
        result.result = list;
        return result;
    }
}