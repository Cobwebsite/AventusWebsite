:host {
    height: 100%;
    overflow: hidden;
    width: 100%;

    av-scrollable {
        height: 100%;
        width: 100%;
        /* define the padding needed inside the scrollbar */
        --scrollbar-content-padding: 15px;

        .page-title {
            height: 50px;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            margin: 30px 0;
        }
    }
}