:host {
    .tasks {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 0 15px;
        width: 100%;

        .sub-title {
            font-size: 20px;
        }

        .new-task {
            align-items: center;
            display: flex;
            gap: 10px;

            td-input {
                flex-grow: 1;
            }

            td-icon {
                cursor: pointer;
                flex-shrink: 0;
            }
        }
    }

    .create-container {
        display: flex;
        flex-direction: row;
        justify-content: flex-end;
        margin-top: 15px;
        width: 100%;

        button {
            align-items: center;
            background-color: var(--color-primary-300);
            border: none;
            border-radius: 500px;
            color: var(--font-color);
            cursor: pointer;
            display: flex;
            justify-content: center;
            min-width: 100px;
            padding: 10px;
            transition: background-color 0.2s linear;
            width: fit-content;
        }
    }
}