:host {
    background-color: var(--color-surface-mixed-600);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    height: fit-content;
    overflow: hidden;
    width: 100%;

    label {
        background-color: var(--color-surface-mixed-500);
        padding: 5px 15px;
        width: 100%;
    }

    input {
        background-color: transparent;
        border: none;
        box-shadow: none;
        color: var(--font-color);
        height: 100%;
        margin: 0;
        outline: none;
        padding: 15px 25px;
        width: 100%;
    }
}